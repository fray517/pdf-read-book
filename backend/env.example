# Скопируйте в .env
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_SYNC_URL=sqlite:///./data/app.db

# Брокер Celery — нужен для обработки PDF. Локально: docker compose up redis -d
CELERY_BROKER_URL=redis://localhost:6379/0
# Оставьте пустым, чтобы не дублировать соединения с Redis для «результатов» задач
CELERY_RESULT_BACKEND=

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=

JWT_SECRET=change-me-to-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

STORAGE_PATH=./data/storage

MAX_UPLOAD_MB=80
MAX_PDF_PAGES=500
DAILY_PAGES_QUOTA=200
DAILY_CHARS_QUOTA=500000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

API_V1_PREFIX=/api/v1
